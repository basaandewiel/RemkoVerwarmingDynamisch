[Unit]
Description=REMKO WKF70 vloerverwarming-regeling (goedkoopste laadblok via MQTT; hoofdmodus 1951 of vaste waarde 1975)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/venv/bin/python3 heating_comfort.py --watch
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
